#!/usr/bin/env bash
#
# agent-code-intel v2 — wire a project into the local code-intelligence stack.
#
#   mkdir SMS-system && cd SMS-system
#   agent-code-intel --apply
#
# That one command creates the git repo if missing, brings up qdrant and
# ollama if they are not running, creates the GrepAI workspace and its qdrant
# collection, maps the project into it, fixes chunking, registers MCP servers
# for Claude Code and Codex, indexes the repo with GitNexus, writes
# .code-intel, appends the code-intel block to CLAUDE.md / AGENTS.md and
# starts the watcher.
#
# MODES
#   agent-code-intel [ws] [--path DIR]            preview (exit 2 if drift)
#   agent-code-intel [ws] [--path DIR] --apply    do it
#   agent-code-intel --refresh [--path DIR]       re-index + audit, no --apply
#   agent-code-intel --status [--all]             health of one / all projects
#   agent-code-intel --remove [--apply]           tear a project back out
#   agent-code-intel --install                    copy self to ~/.local/bin
#
# WHY --apply IS STILL REQUIRED
#   This touches five global places (~/.grepai/workspace.yaml, ~/.claude.json,
#   ~/.codex/config.toml, a qdrant collection, a watcher daemon). A run in the
#   wrong directory is easy — a Finder double-click lands in $HOME. The flag
#   makes that impossible by accident. It is --apply, not --init, because the
#   script is a reconciler: re-running it repairs drift, so "init" would read
#   wrong on the tenth run. Preview exits 2 when something would change, 0 when
#   everything already matches, so it is usable from cron.
#
# KNOWLEDGE THAT IS EXPENSIVE TO REDISCOVER
#   * nomic-embed-text-v2-moe has a hard 512-token window. GrepAI's default
#     chunking.size of 512 overflows it: every chunk is re-split three times
#     and then dropped, so whole files never reach the index. 256/25 indexes
#     cleanly; 384 already loses files.
#   * qdrant answers on 6333 (HTTP health) and 6334 (gRPC). grepai stores and
#     queries vectors on 6334. A container published with only 6333 passes a
#     naive health check and then fails every index. Both are checked.
#   * <project>/.grepai/config.yaml is owned by this script. A running watcher
#     holds it in memory and rewrites the WHOLE file on every index, so hand
#     edits vanish silently, minutes or hours later. Step 3 restarts the
#     watcher after it edits the file. Never hand-edit that file; re-run this.
#   * `codex mcp add` has no scope or cwd flag — every entry is global. One
#     "grepai" entry therefore cannot carry a per-project --workspace, so this
#     registers "grepai-<workspace>", one per project.
#   * A plain global "grepai" entry (args = ["mcp-serve"], no --workspace) in
#     either agent serves the LOCAL gob index instead of the qdrant workspace.
#     Search keeps "working" and silently answers from the wrong data. Both
#     agents are checked for it.
#   * npm's global bin is an nvm-versioned shim. It survives a node switch as a
#     broken file on PATH, so gitnexus is verified by running it. MCP entries
#     register it by NAME, never by absolute path, for the same reason.
#   * `gitnexus analyze` WRITES INTO THE PROJECT: its own AGENTS.md and
#     CLAUDE.md (in <!-- gitnexus:start --> markers) plus six skill files under
#     .claude/skills/. So step 8 cannot ask "does AGENTS.md exist" to decide
#     whether the project keeps one — step 6 just made it, and --agent claude
#     would adopt it. It asks whether anything is in it besides that block.
#     Those files are also dead weight in the semantic index (measured: 73 of
#     96 vectors on a five-file project), hence .claude in the ignore list.
#   * The refusals below ($HOME, /, a parent of $HOME) guard a directory this
#     script would WRITE to. `--status --all` reads the registry and never
#     looks at $PWD, so applying them there only breaks the one command you
#     run after a reboot, from the one directory a fresh terminal opens in.
#
# CONFIG
#   Every default below can be overridden in
#   ${XDG_CONFIG_HOME:-~/.config}/code-intel/defaults.env, which is sourced if
#   present. That file survives upgrades of this script.
#
# STATE THIS CREATES
#   ~/.grepai/workspace.yaml               workspace + project registry
#   ~/.config/code-intel/projects          this script's own project registry
#   ~/.claude/settings.json                one permissions.allow rule for
#                                          agent-code-intel --refresh (--install, --no-perms)
#   ~/.claude.json                         user-scope gitnexus MCP entry
#   ~/.codex/config.toml                   grepai-<ws> + gitnexus MCP entries
#   <project>/.grepai/config.yaml          chunking + ignore list
#   <project>/.mcp.json                    project-scope grepai MCP entry
#   <project>/.code-intel                  identity: WORKSPACE + PROJECT
#   <project>/CLAUDE.md, AGENTS.md         the <!-- code-intel --> block
#   <project>/.gitignore                   .grepai/ and .gitnexus/
#   qdrant collection workspace_<ws>       inside the container's volume
#
# Written for bash 3.2 (macOS system bash): no associative arrays, no mapfile,
# no ${var,,}, and no bare expansion of possibly-empty arrays under `set -u`.

set -euo pipefail

VERSION="2.4.1"

# ---------------------------------------------------------------- defaults --

QDRANT_HOST="127.0.0.1"
QDRANT_HTTP_PORT=6333
QDRANT_PORT=6334
QDRANT_CONTAINER="grepai-qdrant"
QDRANT_IMAGE="qdrant/qdrant"
QDRANT_VOLUME="grepai-qdrant-data"

OLLAMA_HTTP="http://localhost:11434"
