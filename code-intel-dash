footer{margin-top:34px;padding-top:14px;border-top:1px solid var(--rule);
 font-size:11.5px;color:var(--faint);font-family:"IBM Plex Mono",monospace}
</style></head><body>
<div class="wrap">
  <header class="top">
    <h1>code-intel <span id="hostv"></span></h1>
    <div class="age">read <b id="age">—</b> · <span id="took"></span>
      <button id="refresh">Refresh</button></div>
  </header>
  <div id="staleWarn"></div>
  <div id="app"><p style="color:var(--faint);padding:30px 0">Loading…</p></div>
  <footer id="foot"></footer>
</div>
<script>
const $ = s => document.querySelector(s);
const STALE_AFTER = __STALE__;
let last = 0, data = null;

/* Per-workspace UI state, kept OUTSIDE the render so the 15s poll cannot throw
   away a search you are reading. Everything the tabs show is cached here and
   restored on every re-render. */
const ui = {};
const st = ws => (ui[ws] = ui[ws] || {tab:"overview", search:null, files:null,
                                      log:null, q:"", n:10, busy:false});

/* Deep link: #<workspace>/<tab>[/<query>]. The address bar then names what you
   are looking at, so a tab can be bookmarked and reopened where you left it —
   and reloading does not dump you back on the overview. */
const TABS = ["overview","search","index","log"];
function readHash(){
  const raw = decodeURIComponent(location.hash.replace(/^#/,""));
  if(!raw) return null;
  const [ws, tab, ...rest] = raw.split("/");
  if(!ws || !TABS.includes(tab)) return null;
  const s = st(ws);
  s.tab = tab;
  if(rest.length) s.q = rest.join("/");
  return {ws, tab, q: rest.join("/")};
}
function writeHash(ws){
  const s = st(ws);
  const q = (s.tab === "search" && s.q) ? "/" + encodeURIComponent(s.q) : "";
  const next = "#" + encodeURIComponent(ws) + "/" + s.tab + q;
  if(location.hash !== next) history.replaceState(null, "", next);
}

const esc = s => String(s==null?"":s).replace(/[&<>"]/g,
  c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const cls = v => v === true ? "ok" : v === false ? "bad" : "idle";
const row = (k,v,state) => `<dt>${esc(k)}</dt><dd class="${state||""}">${esc(v)}</dd>`;

function card(title, state, sub, rows, err, note, fix){
  return `<div class="card ${state}">
    <h3><span class="dot ${state}"></span>${esc(title)}</h3>
    ${sub?`<div class="sub">${esc(sub)}</div>`:""}
    <dl class="kv">${rows.join("")}</dl>
    ${err?`<div class="err">${esc(err)}</div>`:""}
    ${note?`<div class="note">${esc(note)}</div>`:""}
    ${fix?`<div class="fix">${fix}</div>`:""}
  </div>`;
}

/* split "a/b/c.js" into dim directory + bold basename */
function splitPath(p){
  const i = String(p).lastIndexOf("/");
  return i < 0 ? ["", p] : [p.slice(0, i+1), p.slice(i+1)];
}

function codeTable(content, startLine){
  const lines = String(content).replace(/\n$/,"").split("\n");
  let n = Number(startLine)||1, out = "";
  for(const ln of lines){
    out += `<tr><td class="ln">${n++}</td><td class="src">${esc(ln)}</td></tr>`;
  }
  return `<div class="code"><table>${out}</table></div>`;
}

/* ------------------------------------------------------------- stack ---- */
function renderStack(d){
  const s=d.status, tool=s.tool||{}, svc=s.svc||{}, meta=s.meta||{};
  const q=d.components.qdrant||{}, o=d.components.ollama||{}, mcp=d.components.mcp||{};
  const nd=tool.node||{};
  let h = `<h2>Stack</h2><div class="grid">`;

  const cont=svc.container||{}, ports=cont.qdrant_ports||"";
  const bothPorts = ports.includes("6333") && ports.includes("6334");
  h += card(cont.cli||"kontejnery",
    cont.daemon ? ((cont.qdrant_state==="running" && bothPorts)?"ok":"warn") : "bad",
    cont.name||"", [
      row("daemon", cont.daemon?"running":"stopped", cls(!!cont.daemon)),
      row("container", cont.qdrant_state||"absent", cont.qdrant_state==="running"?"ok":"bad"),
      row("both ports", bothPorts?"6333 + 6334":"NO", bothPorts?"ok":"bad"),
    ],
    cont.daemon?null:"Start OrbStack or Docker Desktop.",
    (cont.daemon && !bothPorts)
      ? "The container does not publish 6334. GrepAI reads and writes vectors there, so every index will fail." : null);

  h += card("qdrant", q.ok?"ok":"bad", q.version?("v"+q.version):"", [
      row("HTTP 6333", q.healthz?"200 ok":"no answer", cls(!!q.healthz)),
      row("gRPC "+((svc.qdrant||{}).grpc_port||"6334"), q.grpc?"open":"closed", cls(!!q.grpc)),
      row("latency", (q.ms||0)+" ms"),
      row("collections", (q.collections||[]).length),
    ], q.error,
    (q.healthz && !q.grpc)
      ? "HTTP answers but gRPC does not. Search will look alive while storing and finding nothing." : null);

  const overflow = o.context_length && meta.chunk_size &&
                   Number(meta.chunk_size) > Number(o.context_length);
  h += card("ollama", o.ok?"ok":(o.reachable?"warn":"bad"), meta.embed_model||"", [
      row("server", o.reachable?"answering":"no answer", cls(!!o.reachable)),
      row("model pulled", o.model_present?"yes":"no", cls(!!o.model_present)),
      row("loaded", o.loaded?"yes":"no", o.loaded?"ok":""),
      row("context window", o.context_length?(o.context_length+" tokens"):"—", overflow?"bad":""),
      row("embed probe", o.ok?(o.dimensions+" dim / "+o.embed_ms+" ms"):"failed", cls(!!o.ok)),
    ], o.error,
    overflow ? `chunk ${meta.chunk_size} overflows the ${o.context_length}-token window — files will drop out of the index silently` : null);

  h += card("Node.js", nd.present?(nd.register_hooks?"ok":"bad"):"bad", nd.path||"", [
      row("version", nd.version||"—"),
      row("registerHooks", nd.register_hooks?"function":"MISSING", cls(!!nd.register_hooks)),
      row("gitnexus", (tool.gitnexus||{}).runs?((tool.gitnexus||{}).version||"ok"):"will not run",
          cls(!!(tool.gitnexus||{}).runs)),
      row("grepai", ((tool.grepai||{}).version||"—").replace("grepai version ",""),
          cls(!!(tool.grepai||{}).present)),
    ],
    (nd.present && !nd.register_hooks) ? "gitnexus --version passes, but analyze dies on registerHooks." : null,
    (nd.present && !nd.register_hooks) ? "Needs Node 22.15+ / 23.5+. See chapter 7 of the manual." : null);

  /* MCP servers: a server started before the package was upgraded is still
     running the old code and will reject the newer index. */
  const srv = mcp.servers||[];
  const state = srv.length ? (mcp.stale?"bad":"ok") : "idle";
  let body = srv.length
    ? srv.map(x => `<div class="srv">
        <span class="dot ${x.stale?"bad":"ok"}"></span>
        <span class="who">${esc(x.owner)}</span>
        <span class="pid">${esc(x.pid)}</span>
        <span class="up">${esc(x.etime)}</span>
        <span class="chip ${x.stale?"bad":"ok"}">${x.stale?"stale":"ok"}</span>
      </div>`).join("")
    : `<p class="hint">No server running. One starts when you open an agent in a project.</p>`;
  h += `<div class="card ${state}">
      <h3><span class="dot ${state}"></span>MCP servers</h3>
      <div class="sub">gitnexus mcp · running since the client started</div>
      ${body}
      ${mcp.stale ? `<div class="err">${mcp.stale} server(s) running an older version
        than the index — queries will fail with &ldquo;DB version mismatch&rdquo;.</div>
        <div class="fix">Restart the client, or
        <code>kill ${esc(srv.filter(x=>x.stale).map(x=>x.pid).join(" "))}</code></div>` : ""}
    </div>`;

  return h + `</div>`;
}

/* ---------------------------------------------------------- projects ---- */
function tabBtn(ws, id, label, count){
  const a = st(ws).tab === id;
  return `<button role="tab" aria-selected="${a}" data-ws="${esc(ws)}" data-tab="${id}">
    ${esc(label)}${count!=null?`<span class="count">${esc(count)}</span>`:""}</button>`;
}

function paneOverview(p, meta){
  const gn=p.gitnexus||{}, col=p.collection_stats||{}, se=p.search||{},
        nd=(data.status.tool||{}).node||{};
  let h = `<div class="cols">`;
  h += `<div class="cell"><h4>GrepAI</h4><dl class="kv">
    ${row("watcher", p.watcher?"running":"STOPPED", cls(!!p.watcher))}
    ${row("vectors", col.exists?(col.points??0):"no collection", (col.exists&&!col.empty)?"ok":"bad")}
    ${row("collection", col.status||"—", col.status==="green"?"ok":"")}
    ${row("dimensions", col.dimensions||"—")}
    ${row("probe query", se.ok?(se.results+" hits / "+se.ms+" ms"):"—", cls(se.ok))}
  </dl>`;
  if(col.exists && col.empty)
    h += `<div class="err">The collection is empty — search returns nothing and it looks like a bad query.</div>`;
  if(!p.watcher)
    h += `<div class="err">The watcher is not running. Search keeps &ldquo;working&rdquo; while answering from stale data.</div>
          <div class="fix">Fix: <code>agent-code-intel --path ${esc(p.path)} --refresh</code></div>`;
  h += `</div>`;

  h += `<div class="cell"><h4>GitNexus</h4><dl class="kv">
    ${row("graph", gn.present?(gn.nodes+" nodes / "+gn.edges+" edges"):"not indexed", cls(gn.present&&gn.nodes>0))}
    ${row("files", gn.files??"—")}
    ${row("indexed", gn.age?(gn.age+" ago"):"—")}
    ${row("commit", gn.indexed_commit?(gn.indexed_commit+((gn.head_commit&&gn.head_commit!==gn.indexed_commit)?(" ≠ "+gn.head_commit):"")):"—",
           gn.fresh===false?"bad":(gn.fresh?"ok":""))}
    ${row("built with Node", gn.built_with_node||"—",
           (gn.built_with_node&&nd.version&&gn.built_with_node!==nd.version)?"warn":"")}
  </dl>`;
  if(gn.error) h += `<div class="err">${esc(gn.error)}</div>`;
  if(gn.built_with_node && nd.version && gn.built_with_node!==nd.version)
    h += `<div class="note">The index was built under Node ${esc(gn.built_with_node)}; ${esc(nd.version)} is running now.</div>`;
  if(gn.fresh===false)
    h += `<div class="fix">Fix: <code>agent-code-intel --path ${esc(p.path)} --refresh</code></div>`;
  h += `</div>`;

  h += `<div class="cell"><h4>Konfigurace</h4><dl class="kv">
    ${row("workspace", p.workspace_exists?"exists":"missing", cls(!!p.workspace_exists))}
    ${row("mapping", p.mapped?"matches":"WRONG PATH", cls(!!p.mapped))}
    ${row("embedder", p.embedder||"—", p.embedder==="match"?"ok":(p.embedder==="mismatch"?"bad":""))}
    ${row("chunking "+meta.chunk_size+"/"+meta.chunk_overlap, p.chunking_ok?"ok":"differs", cls(!!p.chunking_ok))}
    ${row("ignore list", p.ignores_ok?"ok":"incomplete", cls(!!p.ignores_ok))}
  </dl>`;
  if(p.gob_leftover) h += `<div class="note">Leftover .grepai/index.gob — safe to delete.</div>`;
  if(!p.ok) h += `<div class="fix">Fix: <code>agent-code-intel --path ${esc(p.path)} --agent claude --apply</code></div>`;
  h += `</div></div>`;
  return h;
}

function paneSearch(p){
  const s = st(p.workspace), r = s.search;
  let h = `<div class="pad">
    <div class="searchbar">
      <input type="text" id="q-${esc(p.workspace)}" placeholder="Describe what you are looking for — e.g. &ldquo;where passwords are verified&rdquo;"
             value="${esc(s.q)}" data-ws="${esc(p.workspace)}">
      <select data-nsel="${esc(p.workspace)}">
        ${[5,10,20,30].map(n=>`<option value="${n}"${n===s.n?" selected":""}>${n} hits</option>`).join("")}
      </select>
      <button data-go="${esc(p.workspace)}"${s.busy?" disabled":""}>${s.busy?"Searching…":"Search"}</button>
    </div>
    <p class="hint">Matches on meaning, not on words — a plain sentence works.</p>`;

  if(r){
    h += `<div class="smeta">&ldquo;${esc(r.query)}&rdquo; · ${r.hits.length} hits · ${r.ms} ms</div>`;
    if(r.error && !r.hits.length) h += `<div class="err">${esc(r.error)}</div>`;
    const top = r.hits.length ? Math.max(...r.hits.map(x=>x.score)) : 1;
    for(const x of r.hits){
      const [dir,base] = splitPath(x.path);
      const open = s.open && s.open[x.rank];
      h += `<div class="hit${open?" open":""}" data-hit="${esc(p.workspace)}|${x.rank}">
        <div class="h">
          <span class="caret">▶</span>
          <span class="rank">${x.rank}</span>
          <span class="fname"><span class="fdir">${esc(dir)}</span>${esc(base)}</span>
          <span class="lines">${x.start_line}–${x.end_line}</span>
          <span class="score">
            <span class="bar"><i style="width:${Math.round(100*x.score/(top||1))}%"></i></span>
            <span class="snum">${x.score.toFixed(3)}</span>
          </span>
        </div>
        <div class="b">${codeTable(x.content, x.start_line)}</div>
      </div>`;
    }
  } else {
    h += `<p class="hint" style="margin-top:14px">Nothing searched yet. Type a query above.</p>`;
  }
  return h + `</div>`;
}

function paneFiles(p){
  const s = st(p.workspace), f = s.files;
  if(!f) return `<div class="pad"><p class="hint">Reading the index…</p></div>`;
  if(!f.ok) return `<div class="pad"><div class="err">${esc(f.error||"could not read the index")}</div></div>`;
  const top = Math.max(...f.files.map(x=>x.chunks), 1);
  let h = `<div class="pad">
    <div class="smeta">${f.total} vectors across ${f.files.length} files · ${f.scaffold_chunks} of them stack scaffolding</div>
    <div class="tw"><table class="idx">
      <thead><tr><th>file</th><th class="n">chunks</th><th class="n">share</th><th></th></tr></thead><tbody>`;
  for(const x of f.files){
    const [dir,base] = splitPath(x.path);
    h += `<tr class="${x.scaffold?"scaffold":""}">
      <td class="f"><span class="fdir">${esc(dir)}</span>${esc(base)}
        ${x.scaffold?' <span class="chip idle">scaffolding</span>':""}</td>
      <td class="n">${x.chunks}</td>
      <td class="n">${x.share} %</td>
      <td><span class="sharebar${x.scaffold?" dim":""}"><i style="width:${Math.round(100*x.chunks/top)}%"></i></span></td>
    </tr>`;
  }
  h += `</tbody></table></div>
    <p class="hint" style="margin-top:10px">A file missing from this list is not in the index, and search will never find it.</p></div>`;
  return h;
}

function paneLog(p){
  const s = st(p.workspace), l = s.log;
  if(!l) return `<div class="pad"><p class="hint">Reading the log…</p></div>`;
  if(!l.ok) return `<div class="pad"><div class="err">${esc(l.error||"could not read the log")}</div></div>`;
  let body = "";
  for(const ln of l.lines){
    const m = ln.match(/^\[[^\]]+\]\s+(\S+\s+\S+)\s+(.*)$/);
    const t = m ? m[1] : "", msg = m ? m[2] : ln;
    let k = "";
    if(/Indexed/.test(msg)) k = "idx";
    else if(/error|failed|Error/.test(msg)) k = "errl";
    else if(/warn|Warn/.test(msg)) k = "warnl";
    body += `<div class="logline ${k}"><span class="t">${esc(t)}</span><span>${esc(msg)}</span></div>`;
  }
  return `<div class="pad">
    <div class="smeta">${l.lines.length} lines · written ${l.modified_age_s} s ago · ${Math.round(l.size/1024)} kB</div>
    <div class="logbox" id="log-${esc(p.workspace)}">${body}</div>
    <p class="hint" style="margin-top:10px">${esc(l.path)}</p></div>`;
}

function renderProjects(d){
  const meta = d.status.meta||{};
  let h = `<h2>Projects (${d.projects.length})</h2>`;
  if(!d.projects.length){
    return h + `<div class="card idle"><h3><span class="dot idle"></span>The registry is empty</h3>
      <div class="sub">No project is wired up yet.</div>
      <div class="fix"><code>cd project && agent-code-intel --agent claude --apply</code></div></div>`;
  }
  for(const p of d.projects){
    const ws = p.workspace, s = st(ws);
    const gn=p.gitnexus||{}, se=p.search||{}, col=p.collection_stats||{};
    const allOk = p.ok && gn.ok && se.ok && !col.empty;
    h += `<div class="proj">
      <div class="head">
        <span class="dot ${allOk?"ok":"bad"}"></span>
        <strong>${esc(ws)}</strong>
        <span class="chip ${p.ok?"ok":"bad"}">config ${p.ok?"ok":"drift"}</span>
        <span class="chip ${p.watcher?"ok":"bad"}">watcher ${p.watcher?"running":"stopped"}</span>
        <span class="p">${esc(p.path)}</span>
      </div>
      <div class="tabs" role="tablist">
        ${tabBtn(ws,"overview","Overview")}
        ${tabBtn(ws,"search","Search")}
        ${tabBtn(ws,"index","Index contents", col.exists?(col.points??0):null)}
        ${tabBtn(ws,"log","Watcher log")}
      </div>
      <div class="panel-body">`;
    h += s.tab==="overview" ? paneOverview(p, meta)
       : s.tab==="search"   ? paneSearch(p)
       : s.tab==="index"    ? paneFiles(p)
       :                      paneLog(p);
    h += `</div></div>`;
  }
  return h;
}

function render(d){
  data = d;
  if(d.status_error){
    $("#app").innerHTML = `<div class="card bad"><h3><span class="dot bad"></span>
      agent-code-intel unavailable</h3><div class="err">${esc(d.status_error)}</div>
      <div class="fix">This dashboard has no probes of its own — without that command it knows nothing.
      Try <code>agent-code-intel --status --all --json</code>.</div></div>`;
    return;
  }
  $("#app").innerHTML = renderStack(d) + renderProjects(d);
  const meta = d.status.meta||{};
  $("#hostv").textContent = "· script v"+(meta.script_version||"?")+" · dash v"+d.dash_version;
  $("#took").textContent = "collected in "+d.elapsed_ms+" ms";
  $("#foot").textContent = "agent-code-intel "+(d.script_path||"")+
    "  ·  data from `agent-code-intel --status --all --json`; this dashboard has no probes of its own";
  wire();
}

/* --------------------------------------------------------------- wire --- */
function wire(){
  document.querySelectorAll(".tabs button[data-tab]").forEach(b => {
    b.onclick = () => { const ws=b.dataset.ws; st(ws).tab=b.dataset.tab;
      writeHash(ws); render(data); ensureTabData(ws); };
  });
  document.querySelectorAll("[data-hit]").forEach(el => {
    el.querySelector(".h").onclick = () => {
      const [ws, rank] = el.dataset.hit.split("|");
      const s = st(ws); s.open = s.open || {};
      s.open[rank] = !s.open[rank];
      el.classList.toggle("open");
    };
  });
  document.querySelectorAll("[data-go]").forEach(b => {
    b.onclick = () => doSearch(b.dataset.go);
  });
  document.querySelectorAll("input[data-ws]").forEach(i => {
    i.oninput = () => { st(i.dataset.ws).q = i.value; };
    i.onkeydown = e => { if(e.key === "Enter") doSearch(i.dataset.ws); };
  });
  document.querySelectorAll("select[data-nsel]").forEach(sel => {
    sel.onchange = () => { st(sel.dataset.nsel).n = Number(sel.value); };
  });
  const lb = document.querySelector(".logbox");
  if(lb) lb.scrollTop = lb.scrollHeight;
}

async function doSearch(ws){
  const s = st(ws);
  if(!s.q.trim() || s.busy) return;
  s.busy = true; render(data);
  try{
    const u = `/api/search?ws=${encodeURIComponent(ws)}&q=${encodeURIComponent(s.q)}&n=${s.n}`;
    s.search = await (await fetch(u)).json();
    s.open = {1:true};                       /* top hit open by default */
    writeHash(ws);
  }catch(e){
    s.search = {ok:false, query:s.q, ms:0, hits:[], error:String(e)};
  }finally{
    s.busy = false; render(data);
  }
}

async function ensureTabData(ws){
  const s = st(ws);
  const p = (data.projects||[]).find(x => x.workspace === ws) || {};
  if(s.tab === "index" && !s.files){
    const url = ((data.status.svc||{}).qdrant||{}).http_url || "";
    try{ s.files = await (await fetch(
      `/api/files?ws=${encodeURIComponent(ws)}&url=${encodeURIComponent(url)}`)).json(); }
    catch(e){ s.files = {ok:false, error:String(e)}; }
    render(data);
  }
  if(s.tab === "log" && !s.log){
    try{ s.log = await (await fetch(`/api/log?ws=${encodeURIComponent(ws)}&n=250`)).json(); }
    catch(e){ s.log = {ok:false, error:String(e), lines:[]}; }
    render(data);
  }
}

function tick(){
  if(!last) return;
  const age = (Date.now()-last)/1000;
  $("#age").textContent = age<60 ? Math.round(age)+" s ago" : Math.round(age/60)+" min ago";
  const stale = age > STALE_AFTER;
  $("#app").classList.toggle("stale", stale);
  $("#staleWarn").classList.toggle("on", stale);
  if(stale) $("#staleWarn").textContent =
    "The last reading is older than "+STALE_AFTER+" s. What is shown may no longer hold — until the page refreshes it says nothing about the current state.";
}

async function load(){
  $("#refresh").disabled = true;
  try{
    const r = await fetch("/api/status", {cache:"no-store"});
    const doc = await r.json();
    let deep = null;
    if(!last) deep = readHash();             /* only on the first load */
    render(doc);
    last = Date.now();
    if(deep){
      ensureTabData(deep.ws);
      if(deep.tab === "search" && deep.q) doSearch(deep.ws);
    }
    /* the log keeps growing; drop the cache so a reopen shows fresh lines */
    for(const ws in ui) ui[ws].log = null;
  }catch(e){
    $("#staleWarn").classList.add("on");
    $("#staleWarn").textContent = "The dashboard server is not responding: "+e;
  }finally{
    $("#refresh").disabled = false;
    tick();
  }
}
$("#refresh").onclick = load;
load();
setInterval(load, 15000);
setInterval(tick, 1000);
</script></body></html>
"""


class Handler(http.server.BaseHTTPRequestHandler):
    def _send(self, code, body, ctype):
        raw = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(raw)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(raw)

    def _json(self, obj):
        self._send(200, json.dumps(obj, ensure_ascii=False, default=str),
                   "application/json; charset=utf-8")

    def do_GET(self):                                        # noqa: N802
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        q = urllib.parse.parse_qs(parsed.query)

        def arg(name, default=""):
            return (q.get(name) or [default])[0]

        if path == "/":
            self._send(200, PAGE.replace("__STALE__", str(STALE_AFTER_S)),
                       "text/html; charset=utf-8")

        elif path == "/api/status":
            try:
                self._json(build_report())
            except Exception as e:                           # noqa: BLE001
                self._json({"status_error": "dashboard failed: %s" % e})

        elif path == "/api/search":
            ws, query = arg("ws"), arg("q")
            if not ws or not query.strip():
                self._json({"ok": False, "error": "workspace or query missing",
                            "hits": []})
                return
            try:
                limit = max(1, min(50, int(arg("n", "10"))))
            except ValueError:
                limit = 10
            self._json(grepai_query(ws, query, limit))

        elif path == "/api/files":
            ws, url = arg("ws"), arg("url")
            if not ws or not url:
                self._json({"ok": False, "error": "workspace missing"})
                return
            self._json(collection_files(url, "workspace_" + ws))

        elif path == "/api/log":
            ws = arg("ws")
            if not ws:
                self._json({"ok": False, "error": "workspace missing", "lines": []})
                return
            try:
                nlines = max(20, min(2000, int(arg("n", "250"))))
            except ValueError:
                nlines = 250
            self._json(read_log(ws, nlines))

        else:
            self._send(404, "not found", "text/plain; charset=utf-8")

    def log_message(self, *a):
        pass                                                 # keep the terminal usable


def main():
    ap = argparse.ArgumentParser(
        prog="code-intel-dash",
        description="Local health dashboard for the code-intelligence stack.")
    ap.add_argument("--port", type=int, default=DEFAULT_PORT)
    ap.add_argument("--once", action="store_true",
                    help="print one JSON report and exit")
    ap.add_argument("--open", action="store_true",
                    help="open a browser once the server is up")
    ap.add_argument("--version", action="version", version="code-intel-dash " + VERSION)
    args = ap.parse_args()

    if args.once:
        rep = build_report()
        json.dump(rep, sys.stdout, indent=2, ensure_ascii=False, default=str)
        sys.stdout.write("\n")
        # Exit non-zero when something is actually wrong, so this is usable
        # from cron or a shell prompt without parsing the document.
        bad = bool(rep.get("status_error"))
        for c in rep.get("components", {}).values():
            bad = bad or not c.get("ok")
        for p in rep.get("projects", []):
            bad = bad or not p.get("ok") or not (p.get("gitnexus") or {}).get("ok")
        return 2 if bad else 0

    if not find_script():
        print("agent-code-intel not found on PATH or beside this script.",
              file=sys.stderr)
        print("The dashboard has no probes of its own and cannot report "
              "anything without it.", file=sys.stderr)
        return 1

    url = "http://127.0.0.1:%d" % args.port
    try:
        srv = http.server.ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    except OSError as e:
        print("cannot bind %s: %s" % (url, e), file=sys.stderr)
        return 1
    print("code-intel-dash %s  ->  %s" % (VERSION, url))
    print("loopback only, no auth. Ctrl+C to stop.")
    if args.open:
        webbrowser.open(url)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
