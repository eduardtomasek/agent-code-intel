# How stale a reading may be before the page stops claiming to know anything.
# A dashboard that keeps showing the last green frame after it stopped
# refreshing is the exact failure it exists to catch.
STALE_AFTER_S = 25


# --------------------------------------------------------------- helpers ---

def run(cmd, timeout=25):
    """Run a command; return (rc, stdout, stderr). Never raises."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout, p.stderr
    except FileNotFoundError:
        return 127, "", "not found: %s" % cmd[0]
    except subprocess.TimeoutExpired:
        return 124, "", "timed out after %ss" % timeout
    except Exception as e:                                   # noqa: BLE001
        return 1, "", str(e)


def http_json(url, payload=None, timeout=20):
    """GET or POST JSON. Returns (ok, parsed_or_error, elapsed_ms)."""
    t0 = time.monotonic()
    try:
        data = json.dumps(payload).encode() if payload is not None else None
        req = urllib.request.Request(
            url, data=data,
            headers={"Content-Type": "application/json"} if data else {},
        )
        with urllib.request.urlopen(req, timeout=timeout) as r:
            body = json.loads(r.read().decode())
        return True, body, int((time.monotonic() - t0) * 1000)
    except urllib.error.HTTPError as e:
        return False, "HTTP %s" % e.code, int((time.monotonic() - t0) * 1000)
    except Exception as e:                                   # noqa: BLE001
        return False, str(e), int((time.monotonic() - t0) * 1000)


def http_ok(url, timeout=10):
    """Is this endpoint answering 200? For endpoints that are NOT JSON —
    qdrant's /healthz replies with the plain text 'healthz check passed', so
    parsing it as JSON reports a healthy server as unreachable."""
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return r.status == 200
    except Exception:                                        # noqa: BLE001
        return False


def find_script():
    """agent-code-intel, preferring one sitting next to this file."""
    here = os.path.join(os.path.dirname(os.path.abspath(__file__)), "agent-code-intel")
    if os.path.isfile(here) and os.access(here, os.X_OK):
        return here
    for d in os.environ.get("PATH", "").split(os.pathsep):
        c = os.path.join(d, "agent-code-intel")
        if os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None


def human_age(iso):
    """'2026-09-07T17:28:48.669Z' -> '12 min'. Empty string when unparseable."""
    if not iso:
        return ""
    import calendar
    try:
        # These stamps are UTC ("...Z"); parse the second-resolution prefix and
        # read it as UTC, so the age is not off by the local offset.
        t = calendar.timegm(time.strptime(iso[:19], "%Y-%m-%dT%H:%M:%S"))
    except Exception:                                        # noqa: BLE001
        return ""
    d = max(0, time.time() - t)
    if d < 90:
        return "%d s" % d
    if d < 5400:
        return "%d min" % (d / 60)
    if d < 172800:
        return "%d h" % (d / 3600)
    return "%d d" % (d / 86400)


def proc_age_seconds(etime):
    """`ps -o etime` gives [[dd-]hh:]mm:ss and is locale-independent, unlike
    lstart — which prints Czech day names here and defeats strptime."""
    try:
        days = 0
        if "-" in etime:
            d, etime = etime.split("-", 1)
            days = int(d)
        parts = [int(x) for x in etime.strip().split(":")]
        while len(parts) < 3:
            parts.insert(0, 0)
        h, m, sec = parts[-3:]
        return days * 86400 + h * 3600 + m * 60 + sec
    except Exception:                                        # noqa: BLE001
        return None


def check_mcp_servers():
    """Find running `gitnexus mcp` servers and flag any that started BEFORE the
    installed package was last written.

    Node reads a package into memory when the process starts, so upgrading
    gitnexus on disk leaves every already-running MCP server on the OLD code.
    The next `analyze` writes an index the new CLI understands and the stale
    server does not, and the agent gets "DB version mismatch, v43 index vs v42
    MCP server" in the middle of a task. Nothing on disk is broken — the reader
    is simply older than the file. Only restarting the client fixes it, so the
    useful thing a dashboard can do is say so before you hit it.
    """
    r = {"ok": True, "servers": [], "stale": 0}
    pkg = os.path.expanduser("~/.npm-global/lib/node_modules/gitnexus")
    if not os.path.isdir(pkg):
        rc, out, _ = run(["npm", "root", "-g"], timeout=15)
        if rc == 0:
            pkg = os.path.join(out.strip(), "gitnexus")
    if not os.path.isdir(pkg):
        r["note"] = "installed gitnexus package not located"
        return r
    r["package_mtime"] = os.path.getmtime(pkg)

    rc, out, _ = run(["ps", "-eo", "pid,etime,command"], timeout=15)
    if rc != 0:
        return r
    now = time.time()
    for line in out.splitlines():
        if "gitnexus" not in line or " mcp" not in line or "grep" in line:
            continue
        cols = line.split(None, 2)
        if len(cols) < 3:
            continue
        pid, etime, cmd = cols[0], cols[1], cols[2]
        age = proc_age_seconds(etime)
        if age is None:
            continue
        started = now - age
        # Who owns it? The parent tells you which client to restart.
        _, ppid_out, _ = run(["ps", "-o", "ppid=", "-p", pid], timeout=10)
        owner = ""
        ppid = ppid_out.strip()
        if ppid:
            _, pcmd, _ = run(["ps", "-o", "command=", "-p", ppid], timeout=10)
            pl = pcmd.lower()
            # Short labels: the card lays these out on one line, and a long
            # one pushes the uptime onto a second row.
            if "vscode" in pl or "visual studio code" in pl:
                owner = "VS Code"
            elif "claude" in pl:
                owner = "terminal"
            elif pcmd.strip():
                owner = os.path.basename(pcmd.strip().split()[0])[:22]
        stale = started < r["package_mtime"]
        if stale:
            r["stale"] += 1
            r["ok"] = False
        r["servers"].append({
            "pid": pid, "etime": etime.strip(), "age_s": age,
            "owner": owner or "?", "stale": stale,
        })
    return r


# ------------------------------------------------------ component checks ---

def check_status(script):
    """Project + service truth, straight from agent-code-intel. No parsing of
    human output: that is exactly what --json exists to avoid."""
    if not script:
        return None, "agent-code-intel not found on PATH or beside this script"
    rc, out, err = run([script, "--status", "--all", "--json"], timeout=90)
    if rc != 0 and not out.strip().startswith("{"):
        return None, (err or out or "exit %s" % rc).strip()[:400]
    try:
        return json.loads(out), None
    except Exception as e:                                   # noqa: BLE001
        return None, "unparseable JSON from agent-code-intel: %s" % e


def check_ollama(endpoint, model):
    """Liveness AND correctness: really embed something and count dimensions.
    A server that answers /api/tags but cannot embed still fails every index."""
    r = {"probe": "embed", "ok": False}
    ok, tags, ms = http_json(endpoint.rstrip("/") + "/api/tags")
    r["reachable"] = ok
    r["tags_ms"] = ms
    if not ok:
        r["error"] = tags
        return r
    names = [m.get("name", "") for m in (tags.get("models") or [])]
    r["models"] = names
    r["model_present"] = any(n == model or n.startswith(model + ":") for n in names)

    # Which models are resident right now, and their real context window —
    # that number is why chunking is 256 and not GrepAI's default 512.
    ok_ps, ps, _ = http_json(endpoint.rstrip("/") + "/api/ps")
    if ok_ps:
        for m in (ps.get("models") or []):
            if m.get("name", "").startswith(model):
                r["loaded"] = True
                r["context_length"] = m.get("context_length")
                r["size_vram"] = m.get("size_vram")
    r.setdefault("loaded", False)

    if not r["model_present"]:
        r["error"] = "model %s is not pulled" % model
        return r

    ok_e, body, ms = http_json(
        endpoint.rstrip("/") + "/api/embed",
        {"model": model, "input": "code intelligence health probe"},
        timeout=60,
    )
    r["embed_ms"] = ms
    if not ok_e:
        r["error"] = "embed call failed: %s" % body
        return r
    vecs = body.get("embeddings") or []
    r["dimensions"] = len(vecs[0]) if vecs else 0
    r["ok"] = r["dimensions"] > 0
    if not r["ok"]:
        r["error"] = "embed returned no vector"
    return r


def check_qdrant(http_url, grpc_port, host, collections_wanted):
    """Stats per collection. points_count == 0 is a broken index wearing a
    green badge, so it is called out rather than shown as healthy."""
    r = {"ok": False, "collections": []}
    ok, root, ms = http_json(http_url.rstrip("/") + "/")
    r["reachable"] = ok
    r["ms"] = ms
    if ok and isinstance(root, dict):
        r["version"] = root.get("version")
    r["healthz"] = http_ok(http_url.rstrip("/") + "/healthz")

    # gRPC is where grepai reads and writes vectors; HTTP health says nothing
    # about it, and a container published with only 6333 fails every index.
    s = socket.socket()
    s.settimeout(2)
    try:
        s.connect((host, int(grpc_port)))
        r["grpc"] = True
    except Exception:                                        # noqa: BLE001
        r["grpc"] = False
    finally:
        s.close()

    if not ok:
        r["error"] = root
        return r

    ok_l, lst, _ = http_json(http_url.rstrip("/") + "/collections")
    names = [c["name"] for c in ((lst.get("result") or {}).get("collections") or [])] if ok_l else []
    for name in sorted(set(names) | set(collections_wanted)):
        c = {"name": name, "exists": name in names}
        if c["exists"]:
            ok_c, info, _ = http_json(http_url.rstrip("/") + "/collections/" + name)
            res = (info.get("result") or {}) if ok_c else {}
            c["status"] = res.get("status")
            c["points"] = res.get("points_count", 0)
            c["segments"] = res.get("segments_count")
            params = ((res.get("config") or {}).get("params") or {}).get("vectors") or {}
            c["dimensions"] = params.get("size")
            c["distance"] = params.get("distance")
            # An empty collection is the interesting failure: search "works"
            # and returns nothing, which reads like a bad query, not a
            # broken index.
            c["empty"] = (c.get("points") or 0) == 0
        r["collections"].append(c)
    r["ok"] = ok and r["grpc"]
    return r


def grepai_query(workspace, query, limit=10):
    """Structured search results. Uses `grepai search --json` rather than
    scraping the pretty output — same reason agent-code-intel grew --json."""
    t0 = time.monotonic()
    rc, out, err = run(
        ["grepai", "search", query, "--workspace", workspace,
         "--json", "-n", str(limit)],
        timeout=90,
    )
    ms = int((time.monotonic() - t0) * 1000)
    if rc != 0:
        return {"ok": False, "ms": ms, "query": query,
                "error": (err or out).strip()[:300], "hits": []}
    try:
        raw = json.loads(out) or []
    except Exception as e:                                   # noqa: BLE001
        return {"ok": False, "ms": ms, "query": query,
                "error": "unparseable JSON from grepai: %s" % e, "hits": []}

    hits = []
    for i, h in enumerate(raw):
        body = h.get("content") or ""
        # grepai repeats "File: <name>" as the first line of every snippet;
        # the path is already its own field, so drop the duplicate.
        body = re.sub(r"^File: .*?\n\n", "", body, count=1)
        path = h.get("file_path") or ""
        # It also prefixes "<workspace>/<project>/" onto the path; strip that
        # so what is shown is the path inside the repository.
        short = re.sub(r"^%s/[^/]+/" % re.escape(workspace), "", path)
        hits.append({
            "rank": i + 1,
            "score": round(float(h.get("score") or 0), 4),
            "path": short,
            "full_path": path,
            "start_line": h.get("start_line"),
            "end_line": h.get("end_line"),
            "content": body,
        })
    return {"ok": bool(hits), "ms": ms, "query": query, "hits": hits,
            "error": None if hits else "query returned no rows"}


def collection_files(http_url, collection, limit=2000):
    """Which files actually reached the index, and how many chunks each got.
    This is the only view that shows a file silently missing — the failure the
    512-token chunk size produces — and how much of the index is scaffolding."""
    r = {"ok": False, "files": [], "total": 0}
    body = {"limit": limit, "with_payload": True, "with_vector": False}
    ok, res, _ = http_json(
        http_url.rstrip("/") + "/collections/%s/points/scroll" % collection,
        body, timeout=45)
    if not ok:
        r["error"] = str(res)[:200]
        return r
    counts = {}
    for pt in ((res.get("result") or {}).get("points") or []):
        pl = pt.get("payload") or {}
        f = pl.get("file_path") or pl.get("path") or pl.get("file") or "?"
        counts[f] = counts.get(f, 0) + 1
    total = sum(counts.values())
    scaffold = (".claude/", "refresh-intel.sh", ".mcp.json",
                "AGENTS.md", "CLAUDE.md", ".gitnexus/")
    for f, c in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0])):
        short = re.sub(r"^[^/]+/[^/]+/", "", f)
        r["files"].append({
            "path": short, "chunks": c,
            "share": round(100.0 * c / total, 1) if total else 0,
            "scaffold": any(x in short for x in scaffold),
        })
    r["total"] = total
    r["scaffold_chunks"] = sum(f["chunks"] for f in r["files"] if f["scaffold"])
    r["ok"] = total > 0
    if not r["ok"]:
        r["error"] = "collection is empty"
    return r


def read_log(workspace, lines=250):
    """Watcher log, enough of it to see what it has been doing."""
    p = os.path.expanduser(
        "~/Library/Logs/grepai/grepai-workspace-%s.log" % workspace)
    if not os.path.isfile(p):
        return {"ok": False, "error": "no log at %s" % p, "lines": []}
    try:
        with open(p, errors="replace") as f:
            tail = f.readlines()[-lines:]
        st = os.stat(p)
        return {"ok": True, "path": p, "size": st.st_size,
                "modified_age_s": int(time.time() - st.st_mtime),
                "lines": [ln.rstrip("\n") for ln in tail]}
    except Exception as e:                                   # noqa: BLE001
        return {"ok": False, "error": str(e), "lines": []}


def check_grepai_search(workspace):
    """Does retrieval actually return rows? The whole stack exists for this
    one question, and nothing else on the page answers it."""
    r = {"workspace": workspace, "ok": False}
    t0 = time.monotonic()
    rc, out, err = run(
        ["grepai", "search", "health probe function definition",
         "--workspace", workspace],
        timeout=60,
    )
    r["ms"] = int((time.monotonic() - t0) * 1000)
    if rc != 0:
        r["error"] = (err or out).strip()[:200]
        return r
    m = re.search(r"Found (\d+) results", out)
    r["results"] = int(m.group(1)) if m else 0
    r["ok"] = r["results"] > 0
    if not r["ok"]:
        r["error"] = "query returned no rows — index is empty or the workspace is wrong"
    return r


def check_gitnexus(path):
    """Read the graph's own metadata instead of shelling out: it carries the
    node/edge counts, the indexed commit, and — the useful part — the Node
    runtime the index was BUILT with."""
    r = {"ok": False, "present": False}
    meta_p = os.path.join(path, ".gitnexus", "meta.json")
    if not os.path.isfile(meta_p):
        r["error"] = "no .gitnexus/meta.json — repository not indexed"
        return r
    try:
        with open(meta_p) as f:
            meta = json.load(f)
    except Exception as e:                                   # noqa: BLE001
        r["error"] = "unreadable meta.json: %s" % e
        return r

    r["present"] = True
    stats = meta.get("stats") or {}
    r["files"] = stats.get("files")
    r["nodes"] = stats.get("nodes")
    r["edges"] = stats.get("edges")
    r["embeddings"] = stats.get("embeddings")
    r["indexed_at"] = meta.get("indexedAt")
    r["age"] = human_age(meta.get("indexedAt"))
    r["branch"] = meta.get("branch")
    r["indexed_commit"] = (meta.get("lastCommit") or "")[:7]

    runtime = ((meta.get("runnerIdentity") or {}).get("runtime") or {})
    r["built_with_node"] = runtime.get("version")
    r["cli_version"] = ((meta.get("runnerIdentity") or {}).get("cliVersion"))

    rc, head, _ = run(["git", "-C", path, "rev-parse", "HEAD"], timeout=10)
    r["head_commit"] = head.strip()[:7] if rc == 0 else ""
    r["fresh"] = bool(r["head_commit"]) and r["head_commit"] == r["indexed_commit"]
    if not r["head_commit"]:
        r["fresh"] = None                                    # repo has no commits
    r["ok"] = (r.get("nodes") or 0) > 0 and r["fresh"] is not False
    if (r.get("nodes") or 0) == 0:
        r["error"] = "graph has no nodes — analyze produced nothing"
    elif r["fresh"] is False:
        r["error"] = "index is at %s, HEAD is %s — run agent-code-intel --refresh" % (
            r["indexed_commit"], r["head_commit"])
    return r


def check_watcher_log(workspace):
    """A watcher can be 'running' and doing nothing. Its log says which."""
    r = {"ok": False}
    p = os.path.expanduser(
        "~/Library/Logs/grepai/grepai-workspace-%s.log" % workspace)
    if not os.path.isfile(p):
        r["error"] = "no log at %s" % p
        return r
    r["path"] = p
    try:
        st = os.stat(p)
        r["size"] = st.st_size
        r["modified_age_s"] = int(time.time() - st.st_mtime)
        with open(p, errors="replace") as f:
            lines = f.readlines()[-6:]
        r["tail"] = [ln.rstrip("\n")[:220] for ln in lines]
        indexed = [ln for ln in lines if "Indexed" in ln]
        r["last_indexed"] = indexed[-1].rstrip("\n")[:220] if indexed else ""
        r["ok"] = True
    except Exception as e:                                   # noqa: BLE001
        r["error"] = str(e)
    return r


# -------------------------------------------------------------- assemble ---

def build_report():
    t0 = time.monotonic()
    script = find_script()
    status, status_err = check_status(script)

    rep = {
        "generated_at": time.time(),
        "dash_version": VERSION,
        "script_path": script,
        "status_error": status_err,
        "status": status,
        "components": {},
        "projects": [],
    }
    if not status:
        rep["elapsed_ms"] = int((time.monotonic() - t0) * 1000)
        return rep

    meta = status.get("meta", {})
    svc = status.get("svc", {})
    qd = svc.get("qdrant", {})
    ol = svc.get("ollama", {})
    model = meta.get("embed_model", "")
    projects = status.get("projects", [])

    host = re.sub(r"^https?://", "", qd.get("http_url", "http://127.0.0.1:6333")).split(":")[0]
    wanted = [p.get("collection") for p in projects if p.get("collection")]

    rep["components"]["qdrant"] = check_qdrant(
        qd.get("http_url", ""), qd.get("grpc_port", 6334), host, wanted)
    rep["components"]["mcp"] = check_mcp_servers()
    rep["components"]["ollama"] = (
        check_ollama(ol.get("endpoint", ""), model)
        if ol.get("present") and ol.get("up")
        else {"ok": False, "reachable": False,
              "error": "ollama is not running" if ol.get("present")
                       else "ollama is not installed"}
    )

    for p in projects:
        entry = dict(p)
        path = p.get("path", "")
        ws = p.get("workspace", "")
        entry["gitnexus"] = check_gitnexus(path) if p.get("exists") else {
            "ok": False, "error": "project directory is gone"}
        entry["watcher_log"] = check_watcher_log(ws) if p.get("watcher") else {
            "ok": False, "error": "watcher is not running"}
        entry["search"] = (
            check_grepai_search(ws)
            if p.get("watcher") and rep["components"]["qdrant"].get("ok")
            else {"ok": False, "skipped": True,
                  "error": "skipped: watcher down or qdrant unreachable"}
        )
        col = next((c for c in rep["components"]["qdrant"].get("collections", [])
                    if c["name"] == p.get("collection")), None)
        entry["collection_stats"] = col or {"exists": False}
        rep["projects"].append(entry)

    rep["elapsed_ms"] = int((time.monotonic() - t0) * 1000)
    return rep


